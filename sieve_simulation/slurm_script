#!/bin/bash

#SBATCH --nodes 1
#SBATCH --partition production
#SBATCH --account halla
#SBATCH --ntasks 1
#SBATCH --cpus-per-task 20
#SBATCH --output=/volatile/halla/apex/mc/temp/slurm/%x.%a.%A.out
#SBATCH --error=/volatile/halla/apex/mc/temp/slurm/%x.%a.%A.err
#SBATCH --mem=1G
#SBATCH --gres=disk:1G


source ~/.login


#check if we're within a slurm job; if not, then "${SLURM_JOB_ID}"=""
if [[ -z "${SLURM_JOB_ID}" ]]
then
    #We aren't in slurm mode. 
    run_id=0000
    n_cpus=$(nproc)
    echo "We are not in a slurm job. n_cpus=${n_cpus}, run_id=${run_id}" 
    
else
    if [[ -n "${SLURM_ARRAY_TASK_ID}" ]];
    then
	run_id=${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}
    else
	run_id=${SLURM_JOB_ID}
    fi
    n_cpus=${SLURM_CPUS_PER_TASK}
    echo "<${0}> run id: $run_id"
fi

arm=${1}
target=${2}
process=${3}
n_events=${4}

# Path to source directory 
SRC_DIR="${WORK_APEX}/apex_mc_generator/sieve_simulation" 

# path to place to put files on the volatile disk
OUTPUT_DIR="/volatile/halla/apex/mc/tracks_sieve"

# path to scratch disk 
SCRATCH_DIR="/scratch/slurm/${SLURM_JOB_ID}"

cd ${SCRATCH_DIR}
cp -r ${SRC_DIR}/* .

cat slurm_run.mac > my_run.mac

echo "" >> my_run.mac
echo "# set number of worker threads" >> my_run.mac
echo "/run/numberOfThreads ${n_cpus}" >> my_run.mac


outfile_stem="${OUTPUT_DIR}/out_sieve_${arm}_${target}_${process}_${run_id}"
echo "" >> my_run.mac
echo "# Set output file" >> my_run.mac
echo "/global/path_outfile ${outfile_stem}.root" >> my_run.mac

echo "" >> my_run.mac
echo "# Pick which arm to use" >> my_run.mac
echo "/global/active_arm ${arm}" >> my_run.mac

echo "" >> my_run.mac
echo "# Pick which target to simulate" >> my_run.mac
echo "/generator/target ${target}" >> my_run.mac

echo "" >> my_run.mac
echo "# Pick which process to simulate" >> my_run.mac
echo "/generator/mode ${process}" >> my_run.mac

echo "" >> my_run.mac
echo "# Start the run" >> my_run.mac
echo "/run/initialize" >> my_run.mac
echo "/run/beamOn ${n_events}" >> my_run.mac 

echo "<${0}>: Executing G4 application" 
time ./exampleB1 my_run.mac
echo "<${0}>: done."

n_hadd_cpus=$(bc <<< "scale=0; $n_cpus/3")
if [[ $n_hadd_cpus -gt 1 ]];
then
    hadd -k -j $n_hadd_cpus ${outfile_stem}.root ${outfile_stem}_* && rm ${outfile_stem}_* 
else 
    hadd -k ${outfile_stem}.root ${outfile_stem}_* && rm ${outfile_stem}_* 
fi


